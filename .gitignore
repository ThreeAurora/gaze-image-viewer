moc_*.cpp
qrc_*.cpp
ui_*.h
*.o
*.obj
*.a
*.lib

# 运行时状态(含个人路径与缩略图数据库,绝不入库)
Gaze.ini
*.log
*.db
*.db-shm
*.db-wal
*.dmp

# 第三方运行库:按 README「从源码构建」自行获取
vendor/

# 分发产物与本地工作区
dist/
release/
backups/
cache/
tmp_probe/

